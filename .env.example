# ==========================================
# Prince Rana Portfolio — Environment Variables
# ==========================================
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or real secrets to version control.

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://ranaprince.dev

# Resend Transactional Email (Server-side only)
RESEND_API_KEY=re_placeholder_secret_key
CONTACT_EMAIL_RECIPIENT=rana.prince1806@gmail.com

# GitHub Public API Token (Optional, for higher rate limits: 5000/hr vs 60/hr)
GITHUB_ACCESS_TOKEN=ghp_placeholder_token

# Distributed Rate Limiting (Upstash Redis - Server-side only)
UPSTASH_REDIS_REST_URL=https://placeholder-domain.upstash.io
UPSTASH_REDIS_REST_TOKEN=placeholder_token
